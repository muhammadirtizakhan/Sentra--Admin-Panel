{
  "markup": "\n  <div class=\"ambient ambient-one\"></div>\n  <div class=\"ambient ambient-two\"></div>\n\n  <!-- Separate company admin login -->\n  <main id=\"admin-login\" class=\"login-layout\">\n    <section class=\"login-intro\">\n      <span class=\"eyebrow\">SENTRA CONTROL CENTER</span>\n\n      <h1>\n        Your workspace.<br>\n        <span>Under your control.</span>\n      </h1>\n\n      <p>\n        Manage company access, review invitation requests and\n        monitor your recording library from one private workspace.\n      </p>\n\n      <div class=\"intro-features\">\n        <article>\n          <span class=\"feature-number\">01</span>\n          <div>\n            <h2>Controlled access</h2>\n            <p>Invite users and assign the devices they can access.</p>\n          </div>\n        </article>\n\n        <article>\n          <span class=\"feature-number\">02</span>\n          <div>\n            <h2>Real workspace data</h2>\n            <p>View registered users and recordings from your database.</p>\n          </div>\n        </article>\n\n        <article>\n          <span class=\"feature-number\">03</span>\n          <div>\n            <h2>A dedicated admin area</h2>\n            <p>Company administration stays separate from the user dashboard.</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"login-card\">\n      <div class=\"login-brand\">\n        <img src=\"/assets/icon.svg\" width=\"46\" height=\"46\" alt=\"\">\n        <div>\n          <strong>SENTRA</strong>\n          <span>Company administration</span>\n        </div>\n      </div>\n\n      <h2>Welcome back.</h2>\n      <p class=\"muted\">Sign in with your company admin credentials.</p>\n\n      <form id=\"admin-login-form\">\n        <label>\n          Admin email\n          <input\n            name=\"email\"\n            type=\"email\"\n            autocomplete=\"username\"\n            maxlength=\"254\"\n            placeholder=\"admin@company.com\"\n            required\n          >\n        </label>\n\n        <label>\n          Password\n          <input\n            name=\"password\"\n            type=\"password\"\n            autocomplete=\"current-password\"\n            maxlength=\"128\"\n            placeholder=\"Enter your password\"\n            required\n          >\n        </label>\n\n        <button class=\"button button-primary login-submit\" type=\"submit\">\n          Sign in to admin\n          <span aria-hidden=\"true\">→</span>\n        </button>\n      </form>\n\n      <div class=\"login-footnote\">\n        Company access only. User accounts cannot sign in here.\n      </div>\n    </section>\n  </main>\n\n  <!-- All navigation remains inside admin -->\n  <div id=\"admin-workspace\" class=\"admin-shell\" hidden>\n    <aside class=\"sidebar\">\n      <button\n        type=\"button\"\n        class=\"brand-button\"\n        data-go=\"overview\"\n        aria-label=\"Open admin overview\"\n      >\n        <img src=\"/assets/icon.svg\" width=\"42\" height=\"42\" alt=\"\">\n        <span>\n          <strong>SENTRA</strong>\n          <small>COMPANY ADMIN</small>\n        </span>\n      </button>\n\n      <div class=\"sidebar-label\">WORKSPACE</div>\n\n      <nav class=\"sidebar-nav\" aria-label=\"Admin navigation\">\n        <button type=\"button\" class=\"nav-button active\" data-go=\"overview\">\n          <span class=\"nav-symbol\" aria-hidden=\"true\">◫</span>\n          Overview\n        </button>\n\n        <button type=\"button\" class=\"nav-button\" data-go=\"requests\">\n          <span class=\"nav-symbol\" aria-hidden=\"true\">✉</span>\n          Invitations\n          <span id=\"nav-pending\" class=\"nav-count\" hidden></span>\n        </button>\n\n        <button type=\"button\" class=\"nav-button\" data-go=\"users\">\n          <span class=\"nav-symbol\" aria-hidden=\"true\">◎</span>\n          Users\n        </button>\n\n        <button type=\"button\" class=\"nav-button\" data-go=\"recordings\">\n          <span class=\"nav-symbol\" aria-hidden=\"true\">▷</span>\n          Recordings\n        </button>\n      </nav>\n\n      <div class=\"sidebar-footer\">\n        <span class=\"status-dot\"></span>\n        <div>\n          <strong>Private company workspace</strong>\n          <small id=\"sidebar-company\">SENTRA</small>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"main-column\">\n      <header class=\"topbar\">\n        <div class=\"topbar-left\">\n          <button\n            type=\"button\"\n            id=\"mobile-menu\"\n            class=\"icon-button\"\n            aria-label=\"Toggle menu\"\n            aria-expanded=\"false\"\n          >\n            ☰\n          </button>\n\n          <div>\n            <span class=\"eyebrow\">COMPANY WORKSPACE</span>\n            <p id=\"header-title\">Overview</p>\n          </div>\n        </div>\n\n        <div class=\"topbar-actions\">\n          <button type=\"button\" id=\"admin-refresh\" class=\"button button-secondary\">\n            ↻ Refresh\n          </button>\n\n          <div class=\"admin-chip\">\n            <span class=\"avatar\" aria-hidden=\"true\">A</span>\n            <div>\n              <strong>Administrator</strong>\n              <small id=\"admin-identity\"></small>\n            </div>\n          </div>\n\n          <button type=\"button\" id=\"admin-logout\" class=\"button button-quiet\">\n            Log out\n          </button>\n        </div>\n      </header>\n\n      <main id=\"admin-content\" class=\"content\" aria-busy=\"false\">\n        <div class=\"page-heading\">\n          <div>\n            <span id=\"page-eyebrow\" class=\"eyebrow\">WORKSPACE AT A GLANCE</span>\n            <h1 id=\"page-title\">Overview</h1>\n            <p id=\"page-description\">\n              A clear view of company access and your recording library.\n            </p>\n          </div>\n\n          <span id=\"last-updated\" class=\"update-label\">Not loaded yet</span>\n        </div>\n\n        <div id=\"page-loading\" class=\"loading-line\" hidden>\n          <span class=\"spinner\"></span>\n          Loading workspace data…\n        </div>\n\n        <section id=\"panel-overview\" class=\"admin-panel\">\n          <div id=\"overview-stats\" class=\"stats-grid\"></div>\n\n          <div class=\"chart-grid\">\n            <article class=\"panel-card\">\n              <div class=\"panel-heading\">\n                <div>\n                  <span class=\"eyebrow\">GROWTH</span>\n                  <h2>User registrations</h2>\n                </div>\n                <span class=\"small-pill\">Last 30 days</span>\n              </div>\n\n              <div id=\"users-chart\" class=\"chart-area\"></div>\n              <p class=\"chart-note\">Based on saved account creation dates.</p>\n            </article>\n\n            <article class=\"panel-card\">\n              <div class=\"panel-heading\">\n                <div>\n                  <span class=\"eyebrow\">RECORDING LIBRARY</span>\n                  <h2>Recordings added</h2>\n                </div>\n                <span class=\"small-pill\">Last 30 days</span>\n              </div>\n\n              <div id=\"recordings-chart\" class=\"chart-area\"></div>\n              <p class=\"chart-note\">\n                Based on recording creation dates, not completion dates.\n              </p>\n            </article>\n          </div>\n\n          <div class=\"chart-grid\">\n            <article class=\"panel-card\">\n              <div class=\"panel-heading\">\n                <div>\n                  <span class=\"eyebrow\">PROCESSING</span>\n                  <h2>Recording statuses</h2>\n                </div>\n              </div>\n\n              <div id=\"recording-statuses\" class=\"breakdown-list\"></div>\n            </article>\n\n            <article class=\"panel-card\">\n              <div class=\"panel-heading\">\n                <div>\n                  <span class=\"eyebrow\">ACCESS REQUESTS</span>\n                  <h2>Invitation statuses</h2>\n                </div>\n\n                <button type=\"button\" class=\"text-button\" data-go=\"requests\">\n                  View requests →\n                </button>\n              </div>\n\n              <div id=\"invitation-statuses\" class=\"breakdown-list\"></div>\n            </article>\n          </div>\n\n          <p id=\"overview-note\" class=\"page-footnote\"></p>\n        </section>\n\n        <section id=\"panel-requests\" class=\"admin-panel\" hidden>\n          <div class=\"section-toolbar\">\n            <label class=\"search-field\">\n              <span>Search requests</span>\n              <input\n                id=\"request-search\"\n                type=\"search\"\n                placeholder=\"Search name or email…\"\n              >\n            </label>\n\n            <label class=\"filter-field\">\n              <span>Status</span>\n              <select id=\"request-status\">\n                <option value=\"\">All statuses</option>\n                <option value=\"pending\">Pending</option>\n                <option value=\"sending\">Sending</option>\n                <option value=\"approved\">Approved</option>\n                <option value=\"failed\">Failed</option>\n                <option value=\"rejected\">Rejected</option>\n              </select>\n            </label>\n          </div>\n\n          <div id=\"email-warning\" class=\"notice notice-warning\" hidden>\n            Email sending is not configured. Check BREVO_API_KEY,\n            BREVO_SENDER_EMAIL and PUBLIC_ORIGIN in the main dashboard .env.\n          </div>\n\n          <p class=\"section-hint\">\n            Select the user’s devices, then send their invitation.\n            The code and instructions will be emailed to that request’s email address.\n          </p>\n\n          <div id=\"admin-requests\" class=\"request-grid\"></div>\n\n          <p class=\"page-footnote\">\n            Latest 200 requests. Approved means accepted by the email provider,\n            not confirmed inbox delivery. Invitation codes expire in 48 hours.\n          </p>\n        </section>\n\n        <section id=\"panel-users\" class=\"admin-panel\" hidden>\n          <div class=\"section-toolbar\">\n            <label class=\"search-field\">\n              <span>Search this page</span>\n              <input\n                id=\"user-search\"\n                type=\"search\"\n                placeholder=\"Search name, email or device…\"\n              >\n            </label>\n\n            <label class=\"filter-field\">\n              <span>Account status</span>\n              <select id=\"user-status\">\n                <option value=\"\">All users</option>\n                <option value=\"active\">Active</option>\n                <option value=\"disabled\">Disabled</option>\n              </select>\n            </label>\n          </div>\n\n          <article class=\"panel-card table-card\">\n            <div class=\"table-scroll\">\n              <table>\n                <thead>\n                  <tr>\n                    <th>User</th>\n                    <th>Account status</th>\n                    <th>Assigned devices</th>\n                    <th>Registered</th>\n                  <th scope=\"col\">Actions</th></tr>\n                </thead>\n\n                <tbody id=\"users-table-body\"></tbody>\n              </table>\n            </div>\n\n            <div class=\"pagination\">\n              <span id=\"users-page-info\"></span>\n\n              <div>\n                <button type=\"button\" id=\"users-prev\" class=\"button button-secondary\">\n                  Previous\n                </button>\n                <button type=\"button\" id=\"users-next\" class=\"button button-secondary\">\n                  Next\n                </button>\n              </div>\n            </div>\n          </article>\n\n          <p class=\"page-footnote\">\n            Read-only user directory. Existing account and device restrictions\n            remain enforced by the server.\n          </p>\n        </section>\n\n        <section id=\"panel-recordings\" class=\"admin-panel\" hidden>\n          <div class=\"section-toolbar\">\n            <label class=\"search-field\">\n              <span>Search this page</span>\n              <input\n                id=\"recording-search\"\n                type=\"search\"\n                placeholder=\"Search recording, device or status…\"\n              >\n            </label>\n          </div>\n\n          <article class=\"panel-card table-card\">\n            <div class=\"table-scroll\">\n              <table>\n                <thead>\n                  <tr>\n                    <th>Recording</th>\n                    <th>Device</th>\n                    <th>Processing status</th>\n                    <th>Video upload</th>\n                    <th>Detection data</th>\n                    <th>Added</th>\n                  </tr>\n                </thead>\n\n                <tbody id=\"recordings-table-body\"></tbody>\n              </table>\n            </div>\n\n            <div class=\"pagination\">\n              <span id=\"recordings-page-info\"></span>\n\n              <div>\n                <button\n                  type=\"button\"\n                  id=\"recordings-prev\"\n                  class=\"button button-secondary\"\n                >\n                  Previous\n                </button>\n\n                <button\n                  type=\"button\"\n                  id=\"recordings-next\"\n                  class=\"button button-secondary\"\n                >\n                  Next\n                </button>\n              </div>\n            </div>\n          </article>\n\n          <p class=\"page-footnote\">\n            Processing and upload states are shown separately.\n            A ready upload does not by itself confirm completed analysis.\n          </p>\n        </section>\n      </main>\n    </div>\n  </div>\n\n  <div id=\"admin-message\" class=\"message-box\" role=\"status\" aria-live=\"polite\"></div>\n\n  \n",
 "scripts": ["/admin/script.js", "/admin/push.js"],
